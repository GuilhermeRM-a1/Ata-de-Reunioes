# Copie este arquivo para .env e preencha os valores.
# Nao versione o .env e nao apague este exemplo.
# Use valores simples: sem aspas, sem espacos e sem $ (o arquivo e lido
# pelo Spring como .properties e pelo script .sh via source).

# --- Banco (usado pela aplicacao) ---
DB_URL=jdbc:postgresql://localhost:5432/reunioes
DB_USER=postgres
DB_PASSWORD=

# --- Banco (usado pelo scripts/criar-admin.sh) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reunioes

# --- Seguranca ---
# Minimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# --- Somente producao ---
CORS_ALLOWED_ORIGINS=https://app.suaempresa.com.br

# --- Admin inicial (somente criar-admin.sh; apague ADMIN_SENHA depois de usar) ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_SENHA=